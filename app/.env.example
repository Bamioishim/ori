# Browser feature flag. Keep this false or unset until a controlled recipient and wallet flow are ready.
VITE_ORI_SETTLEMENT_MODE=preview

# Server-only Vercel environment variable. Never prefix with VITE_ and never commit the real value.
ORI_1CLICK_JWT=

# Server-only JSON allowlist. Only verified Solana addresses are accepted for live payments.
# Example: {"@tolu":{"address":"9x...","chain":"solana","label":"Tolu"}}
ORI_HANDLE_DIRECTORY={}

# Server-only Gmail recovery delivery through SMTP XOAUTH2.
GMAIL_OAUTH_USER=your-sender@gmail.com
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GMAIL_OAUTH_REFRESH_TOKEN=
GMAIL_OAUTH_FROM=ORI <your-sender@gmail.com>
ORI_AUTH_CODE_SECRET=

# Optional NEAR Auth signing relayer base URL (https). Must implement the SDK's /sign-tx endpoint and pay gas from
# a funded NEAR account on a server. Unset = ORI wallet sending stays disabled. Never put a relayer key in VITE_ vars.
VITE_ORI_NEAR_RELAYER_URL=

# Server-only durable store for one-time email codes (Upstash Redis REST). Unset = email codes fail closed.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
